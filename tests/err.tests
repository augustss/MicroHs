# Tests to run with Tools/Tester.hs
# Columns: program expected-stdout expected-stderr stdin mhs-flags
# Using - for expected-stdout, expected-stderr, or stdin means the empty file.
# Using = for expected-stdout or expected-stderr means the file program.ref
# The short form
#  program
# corresponds to
#  program = - - -r
# i.e., using program.ref as the expected stdout, no error, no input,
# and -r to run directly.

